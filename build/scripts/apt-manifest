#!/usr/bin/env python3
"""Write the apt versions.json for a publish on one track or both, keeping
the version of any track the publish does not reach.

    apt-manifest <path> <generated> <production|development|both> <version>

The production key is what every server follows by default and the
development key what servers on the development track follow. A publish on
both sets both keys, since its packages go to both suites; a production or
development publish moves only its own key.
"""
import json
import sys


def main(arguments):
    if len(arguments) != 4:
        sys.stderr.write("Syntax: apt-manifest <path> <generated> <production|development|both> <version>\n")
        return 1
    path, generated, track, version = arguments
    if track not in ("production", "development", "both"):
        sys.stderr.write("apt-manifest: %r is not a release track\n" % track)
        return 1
    try:
        with open(path) as handle:
            tracks = json.load(handle).get("tracks", {})
    except (OSError, ValueError):
        tracks = {}
    for name in ("production", "development"):
        if track in (name, "both"):
            tracks[name] = version
    manifest = {"generated": int(generated), "platform": "apt", "tracks": tracks}
    with open(path, "w") as handle:
        json.dump(manifest, handle)
        handle.write("\n")
    return 0


if __name__ == "__main__":
    sys.exit(main(sys.argv[1:]))
