<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
	<key>Label</key>
	<string>org.mochi-os.server</string>
	<key>ProgramArguments</key>
	<array>
		<string>/usr/local/sbin/mochi-server</string>
		<string>-f</string>
		<string>/etc/mochi/mochi.conf</string>
	</array>
	<key>RunAtLoad</key>
	<true/>
	<key>KeepAlive</key>
	<true/>
	<key>UserName</key>
	<string>_mochi</string>
	<key>GroupName</key>
	<string>_mochi</string>
	<!-- 0077 octal. An integer, not a string: launchd silently ignores a
	     string here, leaving the data files world-readable. -->
	<key>Umask</key>
	<integer>63</integer>
	<key>StandardErrorPath</key>
	<string>/var/log/mochi-server.log</string>
</dict>
</plist>
