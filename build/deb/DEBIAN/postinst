#!/bin/bash

chown -R mochi:mochi /var/lib/mochi
chown -R mochi:mochi /var/cache/mochi

# Files created since UMask=0077 are already private; an install predating it
# keeps its old modes. go-rwx preserves the owner's bits, leaves git's
# read-only loose objects readable, and is idempotent.
chmod -R go-rwx /var/lib/mochi /var/cache/mochi

systemctl daemon-reload

# enable as well as start: WantedBy=multi-user.target only takes effect once the
# .wants symlink exists, so without this the server does not come back after a
# reboot. Skipped on abort-upgrade and friends, where the unit state is already
# whatever the previous install left.
if [ "$1" = configure ]; then
    systemctl enable mochi-server >/dev/null 2>&1 || true
fi
systemctl start mochi-server
