# bash completion for mochictl
#
# Completes the subcommand name, the second word of the two-word subcommands
# and the global flags. The dispatch table in mochictl/commands.go is the
# source, and a Go test keeps this file in step with it. Flags can appear
# anywhere on the command line, so they are offered at every position.

_mochictl() {
	local cur="${COMP_WORDS[COMP_CWORD]}"
	local prev="${COMP_WORDS[COMP_CWORD-1]}"
	local subcommands="backup broadcast check config health identity pipelining pubsub restart restore rsync-filter snapshot start status stop vacuum version worlds"
	local flags="-f -s -j -t -v -h --help"

	# Global flags expecting a path argument.
	case "$prev" in
		-f|-s)
			COMPREPLY=( $(compgen -f -- "$cur") )
			return 0
			;;
	esac

	# If the user is typing a flag, complete from the flag list at any position.
	if [[ "$cur" == -* ]]; then
		COMPREPLY=( $(compgen -W "$flags" -- "$cur") )
		return 0
	fi

	# Find the subcommand among the args (skipping flags and their values).
	local subcommand=""
	local i=1
	while [ "$i" -lt "$COMP_CWORD" ]; do
		case "${COMP_WORDS[i]}" in
			-f|-s)
				i=$((i + 2))
				;;
			-*)
				i=$((i + 1))
				;;
			*)
				subcommand="${COMP_WORDS[i]}"
				break
				;;
		esac
	done

	# No subcommand chosen yet — offer the subcommand list (plus flags).
	if [ -z "$subcommand" ]; then
		COMPREPLY=( $(compgen -W "$subcommands $flags" -- "$cur") )
		return 0
	fi

	# Second word of the two-word subcommands.
	case "$subcommand" in
		config)
			COMPREPLY=( $(compgen -W "show" -- "$cur") )
			return 0
			;;
		broadcast)
			COMPREPLY=( $(compgen -W "lag" -- "$cur") )
			return 0
			;;
		pipelining|pubsub)
			COMPREPLY=( $(compgen -W "status" -- "$cur") )
			return 0
			;;
		check)
			COMPREPLY=( $(compgen -W "starlark" -- "$cur") )
			return 0
			;;
	esac

	# `restore <dir>` and `backup [path]` complete file paths.
	if [ "$subcommand" = "restore" ] || [ "$subcommand" = "backup" ]; then
		COMPREPLY=( $(compgen -f -- "$cur") )
		return 0
	fi

	return 0
}

complete -F _mochictl mochictl
