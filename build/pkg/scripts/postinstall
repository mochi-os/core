#!/bin/bash

chown -R _mochi:_mochi /var/lib/mochi
chown -R _mochi:_mochi /var/cache/mochi

# Files created since UMask=0077 are already private; an install predating it
# keeps its old modes. go-rwx preserves the owner's bits, leaves git's
# read-only loose objects readable, and is idempotent.
chmod -R go-rwx /var/lib/mochi /var/cache/mochi

# The recursive chmod leaves the data directory 0700, which would stop a member
# of the _mochi group from reaching the sockets under run/. Group members need
# traverse only; the server sets the mode of run/ itself.
chmod 0710 /var/lib/mochi

# The payload carries the default configuration beside the live file, so an
# upgrade never overwrites the operator's settings; a first install copies it
# into place.
if [ ! -f /etc/mochi/mochi.conf ]; then
    cp /etc/mochi/mochi.conf.default /etc/mochi/mochi.conf
fi

# Load the launchd service
launchctl bootout system/org.mochi-os.server 2>/dev/null
launchctl bootstrap system /Library/LaunchDaemons/org.mochi-os.server.plist

exit 0
