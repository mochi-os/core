#!/bin/sh
# Index and sign one suite of the apt repository. The suite scans only its own
# pool: stable holds the production releases in pool/main and development the
# .deb-only development builds in pool/development, and a Packages file that
# listed both would offer every server the development builds.
set -e

do_hash() {
	HASH_NAME=$1
	HASH_CMD=$2
	echo "${HASH_NAME}:" >> Release
	for f in $(find -type f); do
		f=$(echo $f | cut -c3-) # remove ./ prefix
		if [ "$f" = "Release" -o "$f" = "Release.base" -o "$f" = "InRelease" -o "$f" = "Release.gpg" ]; then
			continue
		fi
		echo " $(${HASH_CMD} ${f}  | cut -d" " -f1) $(wc -c $f)" >> Release
	done
}

if [ $# -lt 2 ]; then
    echo "Syntax: $0 <root directory of repository> <GPG key> [suite] [pool]"
    exit 1
fi

suite=${3:-stable}
pool=${4:-main}

cd $1

# Generate Packages files for each architecture
for arch in amd64 arm64 armhf; do
    dpkg-scanpackages --arch $arch pool/$pool > dists/$suite/main/binary-$arch/Packages
    gzip -9 -k -f dists/$suite/main/binary-$arch/Packages
done

cd dists/$suite
# Both signed outputs go before hashing: a leftover InRelease would otherwise
# be listed in the new Release with the old file's hash, then signed.
rm -f Release InRelease Release.gpg
cp Release.base Release
echo -n "Date: " >> Release
date -Ru >> Release
do_hash "MD5Sum" "md5sum"
do_hash "SHA1" "sha1sum"
do_hash "SHA256" "sha256sum"

cat Release | gpg --default-key $2 -abs --clearsign > InRelease
