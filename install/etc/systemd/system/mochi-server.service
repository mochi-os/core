[Unit]
Description=Mochi server
After=network.target

[Service]
Type=simple
ExecStart=/usr/sbin/mochi-server
User=mochi
Group=mochi
# Data files are private to the service account. users.db holds entity private
# keys and sessions.db holds session secrets, and SQLite writes its own -wal and
# -shm sidecars carrying the same pages, so the mode has to come from the
# process umask rather than from any one call site. Loosen to 0027 if a backup
# group needs to read the tree.
UMask=0077
Restart=on-failure
RestartSec=1
LimitNOFILE=65535
LimitNPROC=65535

# Binding ports 80 and 443 as an unprivileged user needs the bind capability.
# It is granted to the process here, not written onto the binary.
AmbientCapabilities=CAP_NET_BIND_SERVICE
CapabilityBoundingSet=CAP_NET_BIND_SERVICE

# Sandboxing. The server writes only its data and cache directories, plus a
# log file when mochi.conf names one under /var/log/mochi. AF_NETLINK is what
# interface enumeration uses: without it the server starts but libp2p and
# mDNS never find an address, so it discovers no peers. Two directives from
# mochi-world.service are deliberately absent. MemoryDenyWriteExecute stops
# the UPX-packed binary from unpacking and the wazero runtime from compiling.
# ProtectProc would hide the /proc/<pid>/status the admin socket reads to
# check a connecting user's supplementary groups.
NoNewPrivileges=true
ProtectSystem=strict
ReadWritePaths=/var/lib/mochi /var/cache/mochi
ReadWritePaths=-/var/log/mochi
ProtectHome=true
PrivateTmp=true
PrivateDevices=true
ProtectClock=true
ProtectHostname=true
ProtectKernelLogs=true
ProtectKernelModules=true
ProtectKernelTunables=true
ProtectControlGroups=true
RestrictAddressFamilies=AF_UNIX AF_INET AF_INET6 AF_NETLINK
RestrictNamespaces=true
RestrictRealtime=true
RestrictSUIDSGID=true
LockPersonality=true

[Install]
WantedBy=multi-user.target
