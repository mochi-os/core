#!/bin/bash

# Create the _mochi group and user if they don't exist, on one id that no
# user or group holds. dscl -search matches an attribute value; -read takes a
# record path, and gid/<n> under /Groups never named one.
if ! dscl . -read /Groups/_mochi &>/dev/null || ! dscl . -read /Users/_mochi &>/dev/null; then
    ID=400
    while dscl . -search /Groups PrimaryGroupID "$ID" | grep -q PrimaryGroupID || dscl . -search /Users UniqueID "$ID" | grep -q UniqueID; do
        ID=$((ID + 1))
    done
fi

if ! dscl . -read /Groups/_mochi &>/dev/null; then
    dscl . -create /Groups/_mochi
    dscl . -create /Groups/_mochi PrimaryGroupID $ID
fi

if ! dscl . -read /Users/_mochi &>/dev/null; then
    GID=$(dscl . -read /Groups/_mochi PrimaryGroupID | awk '{print $2}')
    dscl . -create /Users/_mochi
    dscl . -create /Users/_mochi UniqueID $ID
    dscl . -create /Users/_mochi PrimaryGroupID $GID
    dscl . -create /Users/_mochi UserShell /usr/bin/false
    dscl . -create /Users/_mochi NFSHomeDirectory /var/lib/mochi
    dscl . -create /Users/_mochi RealName "Mochi Server"
fi

# Create directories
mkdir -p /var/cache/mochi /var/lib/mochi /etc/mochi

exit 0
