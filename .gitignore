# Local files
local
mochi
mochi-server
mochi-server-*
mochi-server.exe
access
nohup.out
server/server

# Binaries staged into the Docker build context by `make docker-stage`
build/docker/bin/

# Worktrees Claude Code's agents check out inside the repository: each is a
# repository of its own, and `git add -A` records it as a gitlink.
.claude/worktrees/

# Test-runtime DB files created when go test opens a relative path
# (e.g. db/replication.db from tests that don't set data_dir to a tmpdir
# before opening). Harmless on disk but clutters `git status`.
server/db/
server/users/

# Dependencies
node_modules/

# Production build
dist/
dist-ssr/
.vite/

# Environment
# .env*
# !.env.example

# Logs
logs/
*.log
npm-debug.log*
pnpm-debug.log*

# Editor junk
.vscode/*
!.vscode/extensions.json
.idea/
.DS_Store
*.suo
*.njsproj
*.sw?

# OS
Thumbs.db
__pycache__/

# Review and baseline worktrees made beside the tree; never part of it.
.review/
